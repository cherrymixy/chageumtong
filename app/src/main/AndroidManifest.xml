<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 기어: Vehicle SDK Gear API (@RequiresPermission) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 차속: android.car PERF_VEHICLE_SPEED (런타임 권한) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 길안내: NaviHelper requestRoute / 정보 조회(제한속도 등) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- TextToSpeech SDK: 적립 완료 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 카카오맵 타일 + 카카오 로컬 API(주유소 검색) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 주행 중 다른 앱 위 포인트 위젯. Pleos 에뮬레이터엔 설정 화면이 없어 adb appops로 허용 (README) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 주행 알림 (적립·재탑승·N모드 광고) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name=".core.ChageumtongApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CashDriving">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CashDriving"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중(D, 5km/h 초과)에도 화면이 가려지지 않도록: AAOS UX 제한 대상에서 제외 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".core.NotificationCloseReceiver"
            android:exported="false" />
    </application>

</manifest>